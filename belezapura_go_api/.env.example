# Nunca versione o arquivo .env real.
# Banco de dados gerenciado no Supabase (porta 6543 ou 5432 com sslmode=require)
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Segredo de no mínimo 32 caracteres gerado aleatoriamente (ex: openssl rand -hex 32)
JWT_SECRET=

PORT=3050
GIN_MODE=release

# Origens permitidas no CORS (Vercel e Domínio Próprio)
CORS_ORIGINS=https://belezapura.com.br,https://geevheithair-web.vercel.app
APP_REVISION=production-v1

# Integração Supabase Auth (chave pública/anon)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Integração WhatsApp (Docker Evolution API)
WHATSAPP_API_URL=http://localhost:8084
WHATSAPP_API_KEY=

# Credenciais do SuperAdmin inicial (usadas em go run ./cmd/seed)
ADMIN_EMAIL=admin@belezapura.com.br
ADMIN_PASSWORD=
ADMIN_NAME=Administrador da plataforma
