# Nunca versione o arquivo .env real. Gere um segredo aleatório de pelo menos 32 caracteres.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/belezapura?sslmode=require
JWT_SECRET=
PORT=3050
GIN_MODE=release
CORS_ORIGINS=https://SEU_DOMINIO
APP_REVISION=local
# Opcionais: habilitam somente contas provisionadas com auth_provider=supabase.
# Use chave publicavel ou anon legada; nunca service_role/secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Usados somente por go run ./cmd/seed; nunca exiba a senha em logs.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador da plataforma
